JWT_SECRET=dev-secret-change-me

# Honey batch blockchain certification (Polygon Amoy testnet). All three are
# required together — leaving any unset disables the certification worker.
POLYGON_RPC_URL=
BLOCKCHAIN_PRIVATE_KEY=
CONTRACT_ADDRESS=
# Optional, defaults to 80002 (Amoy) if unset.
CHAIN_ID=80002

# AI voice-logging and assistant features. Both keys are required together —
# leaving either unset disables the voice worker and chat assistant.
# Being migrated to OpenRouter below (OR-01..OR-08-BE) — these two stay in
# effect until that migration lands.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional, defaults to /data/audio if unset.
AUDIO_STORAGE_PATH=/data/audio
# Optional, defaults to claude-haiku-4-5 if unset. Better at multi-step tool use,
# higher cost: claude-sonnet-5. Highest quality, highest cost: claude-opus-5.
ANTHROPIC_MODEL=

# OpenRouter migration (see BACKLOG_AI_ASSISTANT.md Epic 4) — not wired into
# any caller yet. Will replace ANTHROPIC_API_KEY/OPENAI_API_KEY/ANTHROPIC_MODEL above.
OPENROUTER_API_KEY=
# Optional, defaults to anthropic/claude-haiku-4.5 if unset.
OPENROUTER_MODEL=
# Optional, defaults to openai/whisper-1 if unset.
OPENROUTER_WHISPER_MODEL=
