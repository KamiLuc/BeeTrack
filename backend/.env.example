JWT_SECRET=dev-secret-change-me

# Honey batch blockchain certification (Polygon Amoy testnet). All three are
# required together — leaving any unset disables the certification worker.
POLYGON_RPC_URL=
BLOCKCHAIN_PRIVATE_KEY=
CONTRACT_ADDRESS=
# Optional, defaults to 80002 (Amoy) if unset.
CHAIN_ID=80002

# AI voice-logging and assistant features (see BACKLOG_AI_ASSISTANT.md Epic 4).
# OPENROUTER_API_KEY is required — leaving it unset disables both the voice
# worker and the chat assistant.
OPENROUTER_API_KEY=
# Optional, defaults to anthropic/claude-haiku-4.5 if unset. Better at multi-step
# tool use, higher cost: anthropic/claude-sonnet-5. Highest quality, highest
# cost: anthropic/claude-opus-5.
OPENROUTER_MODEL=
# Optional, defaults to openai/whisper-1 if unset.
OPENROUTER_WHISPER_MODEL=
# Optional, defaults to /data/audio if unset.
AUDIO_STORAGE_PATH=/data/audio
